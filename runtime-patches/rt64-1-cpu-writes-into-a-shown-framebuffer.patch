diff --git a/src/hle/rt64_present_queue.cpp b/src/hle/rt64_present_queue.cpp
index 3ea827e..5448fa4 100644
--- a/src/hle/rt64_present_queue.cpp
+++ b/src/hle/rt64_present_queue.cpp
@@ -181,6 +181,13 @@ namespace RT64 {
                 // (FramebufferManager::shownAddress()). Taken on a line of its own, off the one Jet Force Gemini's page
                 // patches around.
                 viFb = (viFb != nullptr) ? viFb : fbManager.find(fbManager.shownAddress(present.screenVI));
+
+                // A framebuffer at the VI's address that isn't as wide as the VI's or of its pixel size isn't the one
+                // the VI shows: the VI's check in State::updateScreen gives it none of the CPU's changes, so it is shown
+                // from RAM, as when there is none. Shown, it stood still over what the CPU drew (a scene transition).
+                if ((viFb != nullptr) && ((viFb->width != present.screenVI.fbSize().x) || (viFb->siz != present.screenVI.fbSiz()))) {
+                    viFb = nullptr;
+                }
             }
 
             Framebuffer *presentFb = viFb;
@@ -225,7 +232,18 @@ namespace RT64 {
                     }
                 }
 
-                if (presentFb->interpolationEnabled) {
+                // The CPU wrote into the framebuffer this present shows (the VI found its RAM changed since the list that drew
+                // it): the frames interpolated from that list don't hold what the CPU wrote, and with MSAA every frame shown
+                // comes from them, so a game drawing over its last frame from the CPU (a scene transition) showed that frame
+                // still. Its own target holds the list's last frame and the CPU's writes, so it is shown from that.
+                bool cpuChangedPresentFb = false;
+                for (const FramebufferOperation &op : present.fbOperations) {
+                    if ((op.type == FramebufferOperation::Type::WriteChanges) && (op.writeChanges.address == presentFb->addressStart)) {
+                        cpuChangedPresentFb = true;
+                    }
+                }
+
+                if (presentFb->interpolationEnabled && !cpuChangedPresentFb) {
                     // The workload thread resizes the manager's targets as it draws (RenderTarget::resize() frees their
                     // textures), so where this frame's own target is the first one drawn (without MSAA, or with nothing
                     // interpolated) it is held as for a frame with none interpolated, and let go once that frame is drawn,
@@ -866,6 +884,22 @@ namespace RT64 {
 #           endif
 
                 if (skipPresent) {
+                    // A present dropped for a newer one still writes what the CPU changed into the framebuffer: each change
+                    // is RAM's difference from the one before, so the next present, holding only its own, showed the
+                    // picture without them for good (a scene transition's blotches stopped partway, or never showed).
+                    if (!present.fbOperations.empty()) {
+                        hlslpp::float2 resolutionScale;
+                        {
+                            std::scoped_lock<std::mutex> configurationLock(ext.sharedResources->configurationMutex);
+                            resolutionScale = ext.sharedResources->resolutionScale;
+                        }
+
+                        const std::scoped_lock lock(screenFbChangePoolMutex);
+                        RenderWorkerExecution workerExecution(ext.presentGraphicsWorker);
+                        ext.sharedResources->framebufferManager.performOperations(ext.presentGraphicsWorker, &screenFbChangePool, nullptr, ext.shaderLibrary,
+                            nullptr, present.fbOperations, ext.sharedResources->renderTargetManager, resolutionScale, 0, 0, nullptr);
+                    }
+
                     skipInterpolation();
                     notifyPresentId(present);
                 }
